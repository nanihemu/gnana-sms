# Copy to .env and edit:  cp .env.example .env
# .env is gitignored. Never commit real secrets.

# Django
SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],*.localhost

# Database (defaults match docker-compose.yml)
DB_ENGINE=postgres          # postgres or sqlite (sqlite is for quick local runs only)
DB_NAME=gnana
DB_USER=gnana
DB_PASSWORD=gnana
DB_HOST=localhost
DB_PORT=5432

# Demo users (seeded by `make seed`)
DEMO_PASSWORD=demo1234
